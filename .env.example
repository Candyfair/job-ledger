# --- Vercel + Trigger.dev: Postgres (mTLS client cert auth, see DEPLOYMENT.md) ---
# Local dev: DATABASE_URL points at the docker-compose Postgres service and
# DATABASE_CLIENT_CERT/DATABASE_CLIENT_KEY stay empty (no mTLS on localhost) —
# see DEPLOYMENT.md "Local Development Database". Production (VPS): all three
# are set, and lib/db.ts switches to the mTLS client-cert connection.
DATABASE_URL=
DATABASE_CLIENT_CERT=
DATABASE_CLIENT_KEY=

# --- Vercel + Trigger.dev: LLM providers (consumed only inside /lib/extraction) ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Vercel only: Better Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Vercel only: OAuth providers ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vercel only: invoking Trigger.dev tasks ---
TRIGGER_SECRET_KEY=

# --- GitHub Actions only: migrations workflow (not consumed by the app) ---
SSH_DEPLOY_KEY=
# Only needed if a manual Actions step ever replaces Trigger.dev's native GitHub integration
TRIGGER_ACCESS_TOKEN=
